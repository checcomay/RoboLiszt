\contentsline {figure}{\numberline {1.4}{\ignorespaces Profili di attivazione motoria della \textit {Musician Hand} e sequenze di attivazione motoria.}}{5}{figure.1.4}%
\contentsline {figure}{\numberline {1.5}{\ignorespaces Rappresentazione della mano robotica al pianoforte.}}{6}{figure.1.5}%
