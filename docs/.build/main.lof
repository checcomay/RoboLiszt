\contentsline {figure}{\numberline {2.1}{\ignorespaces Rappresentazione complessiva delle terne di riferimento assegnate ai giunti del manipolatore robotico \textit {RoboLiszt}.}}{10}{figure.2.1}%
\contentsline {figure}{\numberline {2.2}{\ignorespaces Rappresentazione dei limiti articolari nello spazio dei giunti per i 20 DoF del manipolatore.}}{17}{figure.2.2}%
\contentsline {figure}{\numberline {2.3}{\ignorespaces Proiezioni ortogonali nello spazio di lavoro raggiungibile dai cinque end-effector del manipolatore, ottenute tramite campionamento Monte Carlo.}}{17}{figure.2.3}%
\contentsline {figure}{\numberline {2.4}{\ignorespaces Ellissoidi di velocità, di forza e dinamica (Paragrafo~\ref {sec:dyn_manipulability}) del dito medio alla quota di riposo (blu) e a fondo corsa (rosso), con il polso partecipante. La freccia nera indica la direzione principale più debole; le scale di visualizzazione sono riportate nei titoli.}}{27}{figure.2.4}%
\contentsline {figure}{\numberline {2.5}{\ignorespaces Trasmissione verticale dei cinque dita a riposo e a fondo corsa: massima velocità verticale (sinistra), massima forza verticale (centro) e massima accelerazione verticale (destra, normalizzata con i limiti di coppia ipotizzati nel Paragrafo~\ref {sec:dyn_manipulability}).}}{27}{figure.2.5}%
\addvspace {10\p@ }
\addvspace {10\p@ }
\contentsline {figure}{\numberline {4.1}{\ignorespaces Controllo nello spazio dei giunti: la cinematica inversa genera il riferimento articolare e la retroazione chiude l'anello sui soli giunti.}}{36}{figure.4.1}%
\contentsline {figure}{\numberline {4.2}{\ignorespaces Controllo nello spazio operativo: l'anello è chiuso sulle coordinate cartesiane del polpastrello e la forza è trasformata in coppie con $\boldsymbol J_P^\top $; la ridondanza è gestita nel nucleo.}}{36}{figure.4.2}%
\contentsline {figure}{\numberline {4.3}{\ignorespaces Riferimento (sinistra) ed errore di inseguimento in quota (destra) dei controllori nello spazio dei giunti e nello spazio operativo.}}{37}{figure.4.3}%
\contentsline {figure}{\numberline {4.4}{\ignorespaces Controllo di sola posizione contro il tasto. Sinistra: forza a regime in funzione della profondità comandata sotto la superficie, per tre rigidezze; il fondo corsa ($8$~mm) cambia la pendenza. Destra: andamento temporale della forza per $K=3000$~N/m e tre profondità comandate.}}{38}{figure.4.4}%
\contentsline {figure}{\numberline {4.5}{\ignorespaces Controllo di impedenza con ambiente (tasto). La linea tratteggiata è il rilevamento del contatto che azzera l'anticipo di velocità del riferimento (variante \emph {contact-aware}).}}{39}{figure.4.5}%
\contentsline {figure}{\numberline {4.6}{\ignorespaces Impedenza ($K_d=100$~N/m). Sinistra: forza di contatto per vari rapporti di smorzamento (variante \emph {contact-aware}) a confronto con l'impedenza semplice e il controllo rigido. Centro: forza a regime in funzione dell'errore sull'altezza del tasto (le curve delle due varianti di impedenza coincidono). Destra: picco di forza in funzione della velocità di avvicinamento.}}{40}{figure.4.6}%
\contentsline {figure}{\numberline {4.7}{\ignorespaces Controllo ibrido forza/posizione: la matrice di selezione $\boldsymbol S$ assegna $x,y$ all'anello di posizione e $z$ all'anello di forza; una macchina a stati commuta tra avvicinamento (posizione in $z$), contatto (forza in $z$) e ritrazione (linee tratteggiate).}}{41}{figure.4.7}%
\contentsline {figure}{\numberline {4.8}{\ignorespaces Controllo ibrido, profili pp, mf, ff: errore laterale del polpastrello con banda laterale di $40$~rad/s (sinistra) e di $100$~rad/s (centro) e forza verticale con $100$~rad/s (destra).}}{43}{figure.4.8}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {5.1}{\ignorespaces Rappresentazione grafica e mesh 3D del modello multicorpo di RoboLiszt in ambiente di simulazione.}}{48}{figure.5.1}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Task 1: traiettorie dei polpastrelli nello spazio (sinistra), giunti del polso (centro) e indice di singolarit\`a $\sigma _{\min }$ dello Jacobiano del medio (destra). Le aree colorate distinguono le fasi di sollevamento, oscillazione e abbassamento.}}{52}{figure.5.2}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Task 2: quota dei cinque polpastrelli durante la pressione del tasto E4 con il medio. La linea tratteggiata indica il fondo corsa ($-8$~mm); le aree colorate corrispondono alle fasi della legge~\eqref {eq:press_profile}.}}{53}{figure.5.3}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Task 2: configurazione della mano a fondo corsa durante la pressione di E4 con il medio (tasto evidenziato).}}{54}{figure.5.4}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Task 3: quota dei polpastrelli durante l'esecuzione della triade. Le tre dita che suonano scendono insieme al fondo corsa, mentre indice e anulare restano al di sopra della soglia.}}{55}{figure.5.5}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Task 3: configurazione della mano a fondo corsa durante la triade (tasti C4, E4, G4 evidenziati).}}{55}{figure.5.6}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Task 4: moto del carrello (sinistra), posizione laterale dei polpastrelli (centro) ed errore dell'IK della triade traslata di $k$ tasti con sola rotazione del polso (destra: in verde i casi con errore $<0{,}1$~mm). Durante le fasi di pressione indice e anulare, non vincolati lateralmente, seguono il moto del polso entro circa 10~mm.}}{56}{figure.5.7}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.1}{\ignorespaces Task 3 (triade): componenti della coppia sul pitch del polso, su un giunto del medio e su un giunto del mignolo.}}{60}{figure.6.1}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Task 4 (salto d'ottava): forza esercitata dal carrello sulla mano (sinistra) e coppia sul pitch del polso (destra).}}{60}{figure.6.2}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Forza di contatto (sopra) e coppie di compensazione $-\boldsymbol J^\top \boldsymbol F_c$ (sotto) sui giunti attivi del medio (J1, J2: polso; J10--J12: dito) per i profili pp, mf e ff.}}{61}{figure.6.3}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Forza di contatto (sopra) e quota del polpastrello (sotto) per i profili pp, mf e ff: modello a corpi rigidi con controllo nello spazio operativo (a colori) a confronto con il modello con inerzia uniforme della versione iniziale dello studio (in grigio) e con la forza desiderata (tratteggio).}}{63}{figure.6.4}%
