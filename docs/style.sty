% =============================================================
% style.sty
% =============================================================
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{style}[2026/09/03 v1.0 Custom style]

% -------------------------
% Encoding & language
% -------------------------
\RequirePackage[utf8]{inputenc}
\RequirePackage[T1]{fontenc}
\RequirePackage[italian]{babel}

% -------------------------
% Useful basic packages
% -------------------------
\RequirePackage{graphicx}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{enumitem}

% Tables
\RequirePackage[table]{xcolor}
\RequirePackage{longtable}
\RequirePackage{multicol}
\RequirePackage{multirow}

% Mathematics
\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{cancel}
\RequirePackage{esint}

% Code and algorithms
\RequirePackage{listings}
\RequirePackage{etoolbox}

% Figures using TikZ
\RequirePackage{tikz}  
\usetikzlibrary{arrows.meta,positioning,calc}

% Algorithm2e with options
\RequirePackage[
  linesnumbered,
  ruled,
  vlined
]{algorithm2e}

\SetKwComment{tcp}{\gray{$\triangleright$}\ }{}

% =============================================================
% ===                        LAYOUT                         ===
% =============================================================

% --- Page Margins ---
\geometry{
    left=2.5cm,
    right=2.5cm,
    top=2.5cm,
    bottom=2.5cm
}

% --- Header & Footer ---
\pagestyle{fancy}
\setlength{\headheight}{25.22153pt}
\addtolength{\topmargin}{-9.22153pt}
\fancyhf{}
\fancyfoot[C]{\thepage}
\lhead{}
\chead{}
\rhead{\small\leftmark}

% --- Images Path ---
\graphicspath{ {./images/} }

% --- (TOC) ---
\setcounter{tocdepth}{3}

% --- Lists ---
\setlist[itemize]{
    itemsep=0.25em,
    topsep=0.3em,
    parsep=0.0em,
    partopsep=0.0em,
    label=$\circ$
}

\setlist[enumerate]{
    itemsep=0.25em,
    topsep=0.3em,
    parsep=0.0em,
    partopsep=0.0em,
}

% =============================================================
% ===                    HYPERREF SETUP                     ===
% =============================================================
\RequirePackage[
    colorlinks=true,
    citecolor=blue,
    pagebackref=true,
]{hyperref}

\hypersetup{
    colorlinks=true,
    linkcolor=black,
    citecolor=blue,
    urlcolor=blue
}

% --- Bibliography Style ---
\RequirePackage{csquotes}

% --- Customization of backref text for Bibliography ---
\renewcommand*{\backref}[1]{}
\renewcommand*{\backrefalt}[4]{%
    \ifcase #1 %
    \or Cited on page~#2.%
    \else Cited on pages~#2.%
\fi}

% =============================================================
% ===                 UTILITY COMMANDS                      ===
% =============================================================

% --- To remember important things ---
\newcommand{\important}[1]{\begin{center}\large{\red{\textbf{!!! #1 !!!}}}\end{center}}

% --- Comments for Algorithm2e ---
\SetCommentSty{myCommentFont}
\newcommand\myCommentFont[1]{\footnotesize\textit{\gray{#1}}}
\SetKwComment{tcp}{\gray{$\triangleright$}\ }{}
\DontPrintSemicolon % remove semicolons (';') from all algorithms

% --- Change the name of caption in lstlistings ---
\renewcommand{\lstlistingname}{Codice}

% --- Maths & Symbols ---
\newcommand{\rcancel}[1]{%
    \renewcommand{\CancelColor}{\color{red}}%
    \cancel{#1}%
}
\newcommand{\dd}[1]{\frac{\mathrm{d}}{\mathrm{d}#1}} 
\newcommand{\prob}[1]{\mathbb{P}\!\left(#1\right)}  
\newcommand{\expec}[1]{\mathbb{E}\!\left[#1\right]}      
\newcommand{\variance}[1]{\mathrm{Var}\!\left(#1\right)}  
\newcommand{\cov}[1]{\mathrm{Cov}\!\left(#1\right)}       
\newcommand{\expE}[1]{\mathrm{e}^{#1}}    
\newcommand{\norm}[1]{\left\lVert#1\right\rVert}

% --- Text Colors ---
\newcommand{\green}[1]{\textcolor{green!50!black}{#1}}
\newcommand{\magenta}[1]{\textcolor{magenta}{#1}}    
\newcommand{\orange}[1]{\textcolor{orange}{#1}}                
\newcommand{\olive}[1]{\textcolor{olive}{#1}}              
\newcommand{\blue}[1]{\textcolor{blue}{#1}}                
\newcommand{\cyan}[1]{\textcolor{cyan}{#1}}                
\newcommand{\teal}[1]{\textcolor{teal}{#1}}  
\newcommand{\gray}[1]{\textcolor{gray}{#1}}  
\newcommand{\red}[1]{\textcolor{red}{#1}}

