\contentsline {figure}{\numberline {1.1}{\ignorespaces In figura l'ambiente di simulazione per l'esecuzione pianistica di RoboPianist utilizzando il motore fisico open-source MuJoCo.}}{2}{figure.1.1}%
\contentsline {figure}{\numberline {1.2}{\ignorespaces Melodia tratta da \textit {Perception in action}: un sistema robotico in grado di imparare autonomamente a suonare delle melodie musicali.}}{3}{figure.1.2}%
